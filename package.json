{
  "name": "p0stmaster",
  "version": "0.1.0",
  "description": "Desktop and web workspace for planning, adapting, and publishing social content.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.js",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./styles/tailwind.css -o ./dist/tailwind.css --minify",
    "build:js": "esbuild src/main.jsx --bundle --outfile=dist/bundle.js --loader:.jsx=jsx",
    "build": "npm run build:css && npm run build:js",
    "serve": "node ./serve.js",
    "start": "npm run build && npm run serve",
    "desktop": "npm run build && electron .",
    "desktop:mac": "npm run build && electron-builder --mac dmg zip --universal --publish never",
    "desktop:win": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.499.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.akitaengineering.p0stmaster",
    "productName": "p0stmaster",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "index.html",
      "serve.js",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "electron@41.2.0": true,
    "electron-winstaller@5.4.0": true
  }
}
